# Operator configuration only. End users need only the MCP URL and Google sign-in.
GOOGLE_HEALTH_MCP_GOOGLE_CLIENT_ID=
GOOGLE_HEALTH_MCP_GOOGLE_CLIENT_SECRET=
GOOGLE_HEALTH_MCP_STORAGE_ENCRYPTION_KEY=
GOOGLE_HEALTH_MCP_TOKEN_SIGNING_KEY=
GOOGLE_HEALTH_MCP_PUBLIC_BASE_URL=http://127.0.0.1:8001
# Hosted operators should publish their own policy and provide its HTTPS URL.
GOOGLE_HEALTH_MCP_PRIVACY_POLICY_URL=
GOOGLE_HEALTH_MCP_HOST=127.0.0.1
GOOGLE_HEALTH_MCP_PORT=8001
GOOGLE_HEALTH_MCP_DATA_DIR=.local/oauth
# Use the actual assistant callback URL; fixed approved hosts only.
GOOGLE_HEALTH_MCP_ALLOWED_CLIENT_REDIRECT_URIS='["http://127.0.0.1:*/*","http://localhost:*/*","https://claude.ai/*","https://chatgpt.com/*","https://grok.com/*","https://muse.ai/*"]'
